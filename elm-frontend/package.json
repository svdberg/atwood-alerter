{
  "type": "module",
  "name": "elm-frontend",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.4"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "elm-format": "^0.8.7"
